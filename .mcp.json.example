{
  "mcpServers": {
    "testmo": {
      "command": "/path/to/venv/bin/mcp-testmo",
      "args": ["--env-file", ".env"],
      "description": "Testmo MCP server for test case management"
    },
    "clickup": {
      "command": "node",
      "args": [
        "/path/to/Claude Extensions/clickup-mcp/dist/index.js"
      ],
      "env": {
        "CLICKUP_API_KEY": "${CLICKUP_API_KEY}",
        "CLICKUP_TEAM_ID": "${CLICKUP_TEAM_ID}",
        "CLICKUP_PRIMARY_LANGUAGE": "en"
      },
      "description": "ClickUp MCP server for task integration"
    }
  }
}
